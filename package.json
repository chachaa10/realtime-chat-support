{
  "name": "realtime-chat-support",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check": "turbo check",
    "typecheck": "turbo typecheck",
    "lint": "oxlint apps packages",
    "lint:fix": "oxlint --fix apps packages",
    "format": "oxfmt --check apps packages",
    "format:fix": "oxfmt --write apps packages",
    "test": "turbo test",
    "test:watch": "turbo run test:watch --parallel",
    "test:backend": "pnpm --filter backend test",
    "test:backend:watch": "pnpm --filter backend test:watch",
    "test:shared": "pnpm --filter @repo/shared test",
    "test:shared:watch": "pnpm --filter @repo/shared test:watch",
    "test:database": "pnpm --filter @repo/database test",
    "test:database:watch": "pnpm --filter @repo/database test:watch",
    "test:frontend": "pnpm --filter frontend test",
    "test:frontend:watch": "pnpm --filter frontend test:watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ci:check": "pnpm lint && pnpm format && pnpm build && pnpm typecheck && pnpm test",
    "clean": "pnpm --filter backend exec rm -rf dist .cache && pnpm --filter frontend exec rm -rf dist .cache && pnpm --filter @repo/shared exec rm -rf dist .cache && pnpm --filter @repo/database exec rm -rf dist .cache",
    "setup": "pnpm install && turbo build && pnpm db:push",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "db:generate": "pnpm --filter @repo/database exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @repo/database exec drizzle-kit migrate",
    "db:push": "pnpm --filter @repo/database exec drizzle-kit push",
    "db:reset": "rm -f data.db && pnpm --filter @repo/database exec drizzle-kit push",
    "db:seed": "pnpm --filter @repo/shared build && pnpm --filter @repo/database exec tsx src/seed.ts",
    "db:studio": "pnpm --filter @repo/database exec drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/websockets": "^11.1.27",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.16",
    "better-auth": "^1.6.22",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4-5d5b77c",
    "helmet": "^8.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.27",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@thallesp/nestjs-better-auth": "^2.6.1",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^1.0.0-rc.4",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^0.23.0",
    "postcss": "^8.5.16",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.1",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
